{
  "$schema": "https://opencode.ai/config.json",
  // Default model for this project.
  "model": "opencode/deepseek-v4.1-flash-free",
  // Don't let playground log writes trigger watcher updates.
  "watcher": {
    "ignore": ["logs/**"]
  },
  // Ask before running shell commands, except lesson runs. The SlopLang runner is approved too.
  "permissions": [
    {
      "action": "shell",
      "resource": "bootdev run *",
      "effect": "allow"
    },
    {
      "action": "run_slop",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "commit_message",
      "resource": "*",
      "effect": "allow"
    }
  ]
}
