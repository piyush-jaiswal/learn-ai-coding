{
  "$schema": "https://opencode.ai/config.json",
  // Default model for this project.
  "model": "opencode/deepseek-v4.1-flash-free",
  // Compact automatically, keeping 10k recent tokens and a 20k free buffer.
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000
    },
    "buffer": 20000
  },
  // Don't let playground log writes trigger watcher updates.
  "watcher": {
    "ignore": ["logs/**"]
  },
  // Ask before running shell commands, except lesson runs. The SlopLang runner is approved too.
  "permissions": [
    {
      "action": "shell",
      "resource": "bootdev run *",
      "effect": "allow"
    },
    {
      "action": "run_slop",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "commit_changes",
      "resource": "*",
      "effect": "allow"
    },
    // Commits must go through the commit_changes tool. Deny raw git commits,
    // including argument-less ones (a pattern ending in ` *` also matches them).
    {
      "action": "shell",
      "resource": "git commit *",
      "effect": "deny"
    },
    // Always ask before loading the test-program skill.
    {
      "action": "skill",
      "resource": "create-test-program",
      "effect": "ask"
    },
    // Never read env files, including variants like .env.local or .env.example.
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "disabled": true
      },
      // Playwright MCP on bun, pinned to 0.0.80. Headless because this
      // container has no display, and isolated so the profile stays in memory.
      "playwright": {
        "type": "local",
        "command": [
          "bunx",
          "--bun",
          "@playwright/mcp@0.0.80",
          "--isolated",
          "--headless",
          "--browser",
          "chromium"
        ],
        "disabled": true
      },
      // Chrome DevTools MCP on bun. Isolated (temp profile, auto-cleaned),
      // headless because this container has no display. Uses the Chrome for
      // Testing binary bundled with Playwright since no system Chrome is installed.
      // --no-sandbox is required: this container disables unprivileged user
      // namespaces, so Chrome aborts with "No usable sandbox!" without it.
      "chrome-devtools": {
        "type": "local",
        "command": [
          "bunx",
          "--bun",
          "chrome-devtools-mcp@latest",
          "--isolated",
          "--headless",
          "--chromeArg=--no-sandbox",
          "--no-usage-statistics",
          "--executablePath",
          "/home/dev/.cache/ms-playwright/chromium-1243/chrome-linux64/chrome"
        ]
      }
    }
  }
}
